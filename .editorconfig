root = true

[*.py]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 79

[*.{json,yml,yaml,toml}]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Frozen sources and the embedded reading must keep their original bytes.
[philosophy/sources/*]
insert_final_newline = false
trim_trailing_whitespace = false

[README.md]
trim_trailing_whitespace = false
